                <Text style={{ fontSize: 21, fontWeight: 'bold', color: '#1A2230', marginTop: 8 }}>后端 EXIT=0 · 前端 HAP 2.89 MB</Text>
                <Text style={{ fontSize: 16, color: '#4A5568', marginTop: 6, lineHeight: 1.45 }}>mvnw 离线编译 + hvigor 全量 assembleHap，真机可装</Text>
            </Box>
            <Box style={{ flex: 1, background: '#F7F9FC', border: '1px solid #D6DCE5', borderRadius: 12, padding: '14px 24px', justifyContent: 'center' }}>
