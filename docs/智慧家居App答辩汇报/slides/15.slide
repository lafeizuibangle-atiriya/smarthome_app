                <Box style={{ flex: 1, background: '#F0F5FC', borderRadius: 12, padding: '16px 20px' }}>
                    <Text style={{ fontSize: 26, fontWeight: 'bold', color: '#1E4FA8' }}>01</Text>
                    <Text style={{ fontSize: 19, fontWeight: 'bold', color: '#1A2230', marginTop: 8 }}>跨设备联动引擎</Text>
                    <Text style={{ fontSize: 16, color: '#4A5568', marginTop: 6, lineHeight: 1.5 }}>烟雾报警 → 自动开锁 / 关燃气阀</Text>
