                    <Text style={{ fontSize: 26, fontWeight: 'bold', color: '#1E4FA8' }}>02</Text>
                    <Text style={{ fontSize: 19, fontWeight: 'bold', color: '#1A2230', marginTop: 8 }}>系统通知推送</Text>
                    <Text style={{ fontSize: 16, color: '#4A5568', marginTop: 6, lineHeight: 1.5 }}>告警 / 订单状态替代应用内轮询</Text>
