<Slide style={{ width: 1280, height: 720, padding: 0, flexDirection: 'column', background: '#FFFFFF' }}>
    <Box style={{ width: 1280, height: 6, background: '#1E4FA8' }} />
    <Box style={{ width: 1280, height: 78, flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between', padding: '0 40', borderBottom: '1px solid #D6DCE5' }}>
        <Text style={{ fontSize: 32, fontWeight: 'bold', color: '#0E3F8C' }}>系统架构：三层结构 + 四个定时任务</Text>
        <Text style={{ fontSize: 14, color: '#8B97A8', letterSpacing: 3 }}>主讲 · 组长</Text>
    </Box>
    <Box style={{ flex: 1, flexDirection: 'row', gap: 24, padding: '20px 40px 8px 40px' }}>
        <Box style={{ width: 640, background: '#F7F9FC', border: '1px solid #D6DCE5', borderRadius: 12, padding: 14, justifyContent: 'center' }}>
            <svg width={610} height={500} viewBox='0 0 640 520'>
                <rect x='20' y='10' width='600' height='108' rx='10' fill='#E8EFF8' stroke='#1E4FA8' strokeWidth='1.5' />
                <text x='320' y='44' textAnchor='middle' fontSize='21' fontWeight='bold' fill='#0E3F8C'>HarmonyOS App（ArkTS / ArkUI）</text>
                <text x='320' y='74' textAnchor='middle' fontSize='15' fill='#4A5568'>@Entry 页面 ×18 · 复用组件 ×8 · api/ 唯一 URL 出口 · common 常量字典</text>
                <text x='320' y='100' textAnchor='middle' fontSize='15' fill='#4A5568'>HttpClient 统一带 token · 401 统一处理 · 10 秒弹窗节流</text>
                <line x1='320' y1='122' x2='320' y2='162' stroke='#1E4FA8' strokeWidth='2' />
                <polygon points='320,170 313,158 327,158' fill='#1E4FA8' />
                <text x='340' y='152' fontSize='14' fill='#4A5568'>HTTP + header token</text>
                <rect x='20' y='174' width='600' height='150' rx='10' fill='#1E4FA8' />
                <text x='320' y='206' textAnchor='middle' fontSize='21' fontWeight='bold' fill='#FFFFFF'>Spring Boot 三层架构（严格分层）</text>
                <text x='320' y='236' textAnchor='middle' fontSize='15' fill='#DCE8FA'>Controller → Service → Mapper · JWT 拦截器 · 全局异常 → Result</text>
                <text x='320' y='264' textAnchor='middle' fontSize='15' fill='#DCE8FA'>定时任务 ×4：SensorSim(30s) / Scene / Water / Device（定时开关+计量+进度）</text>
                <text x='320' y='292' textAnchor='middle' fontSize='15' fill='#FFC107'>DeviceTypes 字典类：17 种类型唯一事实来源 · sanitizeAction 指令清洗</text>
                <line x1='120' y1='330' x2='120' y2='370' stroke='#1E4FA8' strokeWidth='2' />
                <polygon points='120,378 113,366 127,366' fill='#1E4FA8' />
                <line x1='320' y1='330' x2='320' y2='370' stroke='#1E4FA8' strokeWidth='2' />
                <polygon points='320,378 313,366 327,366' fill='#1E4FA8' />
                <line x1='520' y1='330' x2='520' y2='370' stroke='#1E4FA8' strokeWidth='2' />
                <polygon points='520,378 513,366 527,366' fill='#1E4FA8' />
                <rect x='20' y='382' width='190' height='110' rx='10' fill='#F0F5FC' stroke='#3D7BD9' strokeWidth='1.5' />
                <text x='115' y='424' textAnchor='middle' fontSize='17' fontWeight='bold' fill='#0E3F8C'>MySQL 8</text>
                <text x='115' y='452' textAnchor='middle' fontSize='14' fill='#4A5568'>16 张业务表</text>
                <text x='115' y='474' textAnchor='middle' fontSize='14' fill='#4A5568'>utf8mb4 全中文</text>
                <rect x='225' y='382' width='190' height='110' rx='10' fill='#F0F5FC' stroke='#3D7BD9' strokeWidth='1.5' />
                <text x='320' y='424' textAnchor='middle' fontSize='17' fontWeight='bold' fill='#0E3F8C'>Redis</text>
                <text x='320' y='452' textAnchor='middle' fontSize='14' fill='#4A5568'>邮箱验证码</text>
                <text x='320' y='474' textAnchor='middle' fontSize='14' fill='#4A5568'>60 秒冷却 + 一次性</text>
                <rect x='430' y='382' width='190' height='110' rx='10' fill='#F0F5FC' stroke='#3D7BD9' strokeWidth='1.5' />
                <text x='525' y='424' textAnchor='middle' fontSize='17' fontWeight='bold' fill='#0E3F8C'>和风天气 API</text>
                <text x='525' y='452' textAnchor='middle' fontSize='14' fill='#4A5568'>后端代理 · KEY 不进 App</text>
                <text x='525' y='474' textAnchor='middle' fontSize='14' fill='#4A5568'>10 分钟内存缓存 · 33 城</text>
            </svg>
        </Box>
        <Box style={{ flex: 1, flexDirection: 'column', gap: 14 }}>
            <Box style={{ flex: 1, background: '#F7F9FC', border: '1px solid #D6DCE5', borderRadius: 12, padding: '16px 22px' }}>
                <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 10, marginBottom: 8 }}>
                    <FAIcon name='mobile' style={{ fill: '#1E4FA8', width: 24, height: 24 }} />
                    <Text style={{ fontSize: 22, fontWeight: 'bold', color: '#1A2230' }}>前端：真机可装</Text>
                </Box>
                <Text style={{ fontSize: 18, color: '#4A5568', lineHeight: 1.6 }}>18 个 @Entry 页面 + 5 个 Tab 页，HAP 全量编译 2.89 MB；URL 只出现在 api/ 一层，换后端地址只改一个文件。</Text>
            </Box>
            <Box style={{ flex: 1, background: '#F7F9FC', border: '1px solid #D6DCE5', borderRadius: 12, padding: '16px 22px' }}>
                <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 10, marginBottom: 8 }}>
                    <FAIcon name='server' style={{ fill: '#1E4FA8', width: 24, height: 24 }} />
                    <Text style={{ fontSize: 22, fontWeight: 'bold', color: '#1A2230' }}>后端：模拟即真实</Text>
                </Box>
                <Text style={{ fontSize: 18, color: '#4A5568', lineHeight: 1.6 }}>四个定时任务驱动"活的数据"：环境 30 秒漂移、插座每分钟计量、家电进度倒计时、全设备定时开关每分钟扫描。</Text>
            </Box>
            <Box style={{ flex: 1, background: '#F7F9FC', border: '1px solid #D6DCE5', borderRadius: 12, padding: '16px 22px' }}>
                <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 10, marginBottom: 8 }}>
                    <FAIcon name='database' style={{ fill: '#1E4FA8', width: 24, height: 24 }} />
                    <Text style={{ fontSize: 22, fontWeight: 'bold', color: '#1A2230' }}>数据：三层兜底</Text>
                </Box>
                <Text style={{ fontSize: 18, color: '#4A5568', lineHeight: 1.6 }}>MySQL 存业务、Redis 存验证码、和风天气走后端代理 —— 三方密钥永远不下发到 App 端。</Text>
            </Box>
        </Box>
    </Box>
    <Box style={{ width: 1280, height: 58, flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between', padding: '0 40' }}>
        <Text style={{ fontSize: 14, color: '#8B97A8' }}>智慧家居 App（仿米家）· 课程结项答辩</Text>
        <Text style={{ fontSize: 15, fontWeight: 'bold', color: '#1E4FA8' }}>05 / 24</Text>
    </Box>
</Slide>
