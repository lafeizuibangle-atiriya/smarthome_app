<Slide style={{ width: 1280, height: 720, padding: 0, flexDirection: 'column', background: '#FFFFFF' }}>
    <Box style={{ width: 1280, height: 6, background: '#1E4FA8' }} />
    <Box style={{ width: 1280, height: 78, flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between', padding: '0 40', borderBottom: '1px solid #D6DCE5' }}>
        <Text style={{ fontSize: 32, fontWeight: 'bold', color: '#0E3F8C' }}>sanitizeAction：安全边界划在后端</Text>
        <Text style={{ fontSize: 14, color: '#8B97A8', letterSpacing: 3 }}>主讲 · A · 后端架构</Text>
    </Box>
    <Box style={{ flex: 1, padding: '18px 40px 10px 40px', flexDirection: 'column', gap: 16 }}>
        <Box style={{ flex: 1, background: '#F7F9FC', border: '1px solid #D6DCE5', borderRadius: 12, padding: 12, justifyContent: 'center' }}>
            <svg width={1160} height={280} viewBox='0 0 1200 300'>
                <rect x='15' y='105' width='180' height='90' rx='10' fill='#F0F5FC' stroke='#3D7BD9' strokeWidth='1.5' />
                <text x='105' y='140' textAnchor='middle' fontSize='17' fontWeight='bold' fill='#0E3F8C'>前端 / 接口请求</text>
                <text x='105' y='168' textAnchor='middle' fontSize='14' fill='#4A5568'>action JSON（不可信）</text>
                <line x1='200' y1='150' x2='250' y2='150' stroke='#1E4FA8' strokeWidth='2' />
                <polygon points='258,150 246,143 246,157' fill='#1E4FA8' />
                <rect x='262' y='90' width='200' height='120' rx='10' fill='#1E4FA8' />
                <text x='362' y='132' textAnchor='middle' fontSize='18' fontWeight='bold' fill='#FFFFFF'>sanitizeAction()</text>
                <text x='362' y='158' textAnchor='middle' fontSize='14' fill='#DCE8FA'>control() 第一行永远先清洗</text>
                <text x='362' y='182' textAnchor='middle' fontSize='14' fill='#FFC107'>唯一入口 · 无旁路</text>
                <line x1='466' y1='150' x2='516' y2='150' stroke='#1E4FA8' strokeWidth='2' />
                <polygon points='524,150 512,143 512,157' fill='#1E4FA8' />
                <rect x='528' y='15' width='300' height='78' rx='10' fill='#FFFFFF' stroke='#3D7BD9' strokeWidth='1.5' />
                <text x='678' y='46' textAnchor='middle' fontSize='16' fontWeight='bold' fill='#0E3F8C'>① 只读字段 → 直接丢弃并告警</text>
                <text x='678' y='72' textAnchor='middle' fontSize='13' fill='#4A5568'>水量 / 电量 / 功率 / 电表读数等</text>
                <rect x='528' y='111' width='300' height='78' rx='10' fill='#FFFFFF' stroke='#3D7BD9' strokeWidth='1.5' />
                <text x='678' y='142' textAnchor='middle' fontSize='16' fontWeight='bold' fill='#0E3F8C'>② 数值字段 → 越界抛业务异常</text>
                <text x='678' y='168' textAnchor='middle' fontSize='13' fill='#4A5568'>温度 16~30 · 亮度 1~100 · 开合度 0~100</text>
                <rect x='528' y='207' width='300' height='78' rx='10' fill='#FFFFFF' stroke='#3D7BD9' strokeWidth='1.5' />
                <text x='678' y='238' textAnchor='middle' fontSize='16' fontWeight='bold' fill='#0E3F8C'>③ 枚举字段 → 白名单校验</text>
                <text x='678' y='264' textAnchor='middle' fontSize='13' fill='#4A5568'>空调模式 · 信号源 · 各家电 mode</text>
                <line x1='832' y1='54' x2='882' y2='54' stroke='#D9534F' strokeWidth='2' />
                <polygon points='890,54 878,47 878,61' fill='#D9534F' />
                <line x1='832' y1='150' x2='882' y2='150' stroke='#D9534F' strokeWidth='2' />
                <polygon points='890,150 878,143 878,157' fill='#D9534F' />
                <line x1='832' y1='246' x2='882' y2='246' stroke='#D9534F' strokeWidth='2' />
                <polygon points='890,246 878,239 878,253' fill='#D9534F' />
                <rect x='894' y='95' width='130' height='110' rx='10' fill='#FDEDEC' stroke='#D9534F' strokeWidth='1.5' />
                <text x='959' y='140' textAnchor='middle' fontSize='16' fontWeight='bold' fill='#D9534F'>不合法 → 400</text>
                <text x='959' y='168' textAnchor='middle' fontSize='13' fill='#4A5568'>清洗后为空</text>
                <text x='959' y='188' textAnchor='middle' fontSize='13' fill='#4A5568'>同样拒绝</text>
                <line x1='1028' y1='150' x2='1078' y2='150' stroke='#1E4FA8' strokeWidth='2' />
                <polygon points='1086,150 1074,143 1074,157' fill='#1E4FA8' />
                <rect x='1090' y='105' width='95' height='90' rx='10' fill='#E8EFF8' stroke='#1E4FA8' strokeWidth='1.5' />
                <text x='1137' y='142' textAnchor='middle' fontSize='16' fontWeight='bold' fill='#0E3F8C'>合法</text>
                <text x='1137' y='166' textAnchor='middle' fontSize='14' fill='#0E3F8C'>执行控制</text>
            </svg>
        </Box>
        <Box style={{ flexDirection: 'row', gap: 16, height: 150 }}>
            <Box style={{ flex: 1, background: '#F0F5FC', borderRadius: 12, padding: '16px 24px' }}>
                <Text style={{ fontSize: 22, fontWeight: 'bold', color: '#0E3F8C', marginBottom: 8 }}>动机：接口可以被直调</Text>
                <Text style={{ fontSize: 18, color: '#4A5568', lineHeight: 1.6 }}>App 可以被反编译、Postman 可以直调接口。前端校验只管体验，<span style={{ fontWeight: 'bold', color: '#1A2230' }}>安全边界必须划在后端</span> —— 这是本次开发里最重要的工程共识。</Text>
            </Box>
            <Box style={{ flex: 1, background: '#F0F5FC', borderRadius: 12, padding: '16px 24px' }}>
                <Text style={{ fontSize: 22, fontWeight: 'bold', color: '#0E3F8C', marginBottom: 8 }}>收益：一处白名单管所有字段</Text>
                <Text style={{ fontSize: 18, color: '#4A5568', lineHeight: 1.6 }}>新增字段只需改一处白名单；即使绕过 App 直调接口，也伪造不了水量、电量和运行进度 —— 演示数据永远真实可信。</Text>
            </Box>
        </Box>
    </Box>
    <Box style={{ width: 1280, height: 58, flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between', padding: '0 40' }}>
        <Text style={{ fontSize: 14, color: '#8B97A8' }}>智慧家居 App（仿米家）· 课程结项答辩</Text>
        <Text style={{ fontSize: 15, fontWeight: 'bold', color: '#1E4FA8' }}>08 / 24</Text>
    </Box>
</Slide>
