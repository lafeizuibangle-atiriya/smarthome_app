        </Box>
        <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 18 }}>
            <Box style={{ width: 58, height: 58, background: '#E8EFF8', borderRadius: 8, justifyContent: 'center', alignItems: 'center' }}>
